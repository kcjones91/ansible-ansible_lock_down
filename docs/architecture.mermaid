---
title: Azure VM + Ansible Lockdown Architecture
---
flowchart TB
    subgraph Local["🖥️ Windows Workstation"]
        TF["Terraform"]
        DC["Docker Container<br/>(Ansible)"]
        GV["group_vars/<br/>linux.yml<br/>windows.yml"]
        INV["inventory.ini<br/>(auto-generated)"]
    end

    subgraph Azure["☁️ Azure Cloud"]
        subgraph RG["Resource Group: rg-demo-vms"]
            subgraph VNET["Virtual Network: 10.0.0.0/16"]
                LINUX["🐧 Ubuntu 22.04 VM<br/>vm-linux-demo<br/>SSH (22)"]
                WIN["🪟 Windows Server 2022<br/>vm-win-demo<br/>WinRM (5985)"]
            end
            NSG["Network Security Group"]
            PIP1["Public IP"]
            PIP2["Public IP"]
        end
    end

    subgraph Roles["📦 Ansible Lockdown Roles"]
        UBU["UBUNTU22-CIS"]
        W22["Windows-2022-CIS"]
    end

    TF -->|"creates"| RG
    TF -->|"generates"| INV
    DC -->|"SSH"| LINUX
    DC -->|"WinRM"| WIN
    GV -->|"controls"| Roles
    UBU -->|"hardens"| LINUX
    W22 -->|"hardens"| WIN
    NSG -->|"protects"| VNET
    PIP1 --- LINUX
    PIP2 --- WIN

    classDef azure fill:#0078d4,color:#fff
    classDef local fill:#4a4a4a,color:#fff
    classDef vm fill:#68217a,color:#fff
    
    class Azure,RG,VNET azure
    class Local local
    class LINUX,WIN vm
