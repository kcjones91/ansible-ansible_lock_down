```mermaid
flowchart TB
    subgraph PROJECT["📁 azure-vms/"]
        subgraph TERRAFORM["Terraform"]
            TF1["main.tf<br/>Azure infrastructure"]
            TF2["terraform.tfvars<br/>Your variables"]
            TF3["inventory.ini<br/>(generated)"]
        end

        subgraph DOCKER_FILES["Docker"]
            D1["Dockerfile"]
            D2["docker-compose.yml"]
            D3["entrypoint.sh"]
        end

        subgraph ANSIBLE_FILES["Ansible Config"]
            A1["ansible.cfg"]
            A2["requirements.yml"]
            A3["ansible.cmd"]
            A4["setup.cmd"]
        end

        subgraph GROUP_VARS["group_vars/"]
            GV1["linux.yml<br/>CIS controls for Ubuntu"]
            GV2["windows.yml<br/>CIS controls for Windows"]
        end

        subgraph PLAYBOOKS["Playbooks"]
            PB1["cis-hardening-linux.yml"]
            PB2["cis-hardening-windows.yml"]
            PB3["cis-hardening-all.yml"]
            PB4["test-playbook.yml"]
        end

        subgraph ROLES_DIR["roles/"]
            R1["ubuntu22_cis/<br/>(downloaded)"]
            R2["win2022_cis/<br/>(downloaded)"]
        end
    end

    TF1 --> TF3
    A2 --> ROLES_DIR
    GROUP_VARS --> PLAYBOOKS
    PLAYBOOKS --> ROLES_DIR

    style TERRAFORM fill:#e3f2fd
    style DOCKER_FILES fill:#fff3e0
    style ANSIBLE_FILES fill:#e8f5e9
    style GROUP_VARS fill:#fce4ec
    style PLAYBOOKS fill:#f3e5f5
    style ROLES_DIR fill:#ffecb3
```
